# App
NODE_ENV=development
PORT=4010

# AES key for encrypted `services.configuration` (first 32 chars used; must match ai-worker for Python decrypt)
APP_KEY=agentmarket-default-key-32bytes!!

# MongoDB (local via Docker or Atlas)
MONGODB_URI=mongodb://localhost:27017/agentmarket

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-strong-password

# Celery worker → API (post publish & scheduler must call API; no direct Mongo from worker for posts)
# Generate: openssl rand -hex 24
WORKER_API_SECRET=
# Base URL the worker uses to reach the API (Docker: http://api:4010; local: http://127.0.0.1:4010)
INTERNAL_API_URL=http://127.0.0.1:4010
# Set the same WORKER_API_SECRET in services/ai-worker (or Docker) so publish tasks can call
# GET /api/internal/worker/post-publish-bundle/:id. Missing either → publish fails at runtime.

# Celery bridge: Redis list the API LPUSHes to; Beat runs tasks.bridge_api_celery_queue to forward into Celery (do not use the broker's native queue name here).
CELERY_REDIS_LIST=agentmarket:api_task_bridge
# Optional: Redis key prefix for /ai/* Celery round-trip results (default agentmarket:ai_sync:)
# AI_CELERY_REPLY_PREFIX=agentmarket:ai_sync:

# P2 ads: unset or 0 = Google/Meta reporting & tools via Celery worker (recommended). Set 1 for in-API Node google-ads-api only.
LEGACY_API_EXECUTION_ADS=0
# Set to 1/true to disable Meta Ads Library tool (meta_search_ads_library).
# META_ADS_DISABLE_ADS_LIBRARY=0
# Optional Redis key prefix for P2 synchronous worker replies (default agentmarket:p2_exec_reply:)
# P2_CELERY_REPLY_PREFIX=agentmarket:p2_exec_reply:

# Background jobs: always Celery (services/ai-worker). Run worker + beat locally (see Makefile) or use docker compose.

# JWT (required — generate with: openssl rand -base64 48)
JWT_SECRET=change-me-minimum-32-chars-random-secret
JWT_EXPIRES_IN=7d

# SocketCluster
SC_PORT=8000

# Realtime events channel (Redis Pub/Sub)
EVENTS_CHANNEL=agent_market:events

# Next.js Public (browser may use tunnels — see ONBOARDING / start.sh)
NEXT_PUBLIC_API_URL=http://localhost:4010
# Where the Next.js process proxies /__agentmarket_api → (server-side). Use direct API URL, not ngrok.
# Local `next dev`: http://127.0.0.1:4010. Docker web image build: http://api:4010 (set via compose build arg).
NEXT_REWRITE_API_URL=http://127.0.0.1:4010
NEXT_PUBLIC_SC_HOST=localhost
NEXT_PUBLIC_SC_PORT=8000
# wss:// when true; omit or false for local SocketCluster (http://). Required for TLS-terminated realtime in prod.
# NEXT_PUBLIC_SC_SECURE=false

# Web URL (used by API for CORS)
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Media Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=

# Media Processing
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Social Providers — LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:4010/api/integrations/linkedin/callback
LINKEDIN_AUTHOR_URN=

# Social Providers — Instagram (via Meta)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_CALLBACK_URL=http://localhost:4010/api/integrations/instagram/callback

# Social Providers — TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_CALLBACK_URL=http://localhost:4010/api/integrations/tiktok/callback

# Social Providers — Twitter/X
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_URL=http://localhost:4010/api/integrations/twitter/callback

# Social Providers — Meta (Facebook/Instagram)
META_APP_ID=
META_APP_SECRET=
META_CALLBACK_URL_FACEBOOK_PAGE=http://localhost:4010/api/integrations/facebook_page/callback
# Instagram via Meta uses INSTAGRAM_CALLBACK_URL

# Social Providers — Instagram Login (direct, no Facebook account required)
INSTAGRAM_LOGIN_CALLBACK_URL=http://localhost:4010/api/integrations/instagram_login/callback

# Google Ads
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CALLBACK_URL=http://localhost:4010/callback/google_ads

# Ads automation (Celery Beat — services/ai-worker; requires WORKER_API_SECRET + INTERNAL_API_URL)
# Hourly pacing (:15 UTC): pause overspending campaigns locally when KPI alerts fire
ADS_PACING_AUTO_PAUSE=0
# Hourly bid optimization (:45 UTC): auto-apply safe keyword bid decreases (high-priority only)
ADS_BID_AUTO_APPLY=0

# AI (Gemini, OpenAI, Anthropic) — API keys and models are configured per workspace in the web UI (Settings → AI).
# Do not set GEMINI_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY, or GEMINI_*_MODEL here.

# External Services
UNSPLASH_ACCESS_KEY=
TENOR_API_KEY=
