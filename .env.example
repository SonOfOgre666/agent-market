# App
NODE_ENV=production
PORT=3001

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/mixpost?appName=Cluster0&retryWrites=true&w=majority

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-strong-password

# JWT (required — generate with: openssl rand -base64 48)
JWT_SECRET=change-me-minimum-32-chars-random-secret
JWT_EXPIRES_IN=7d

# SocketCluster
SC_PORT=8000

# Next.js Public
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SC_HOST=localhost
NEXT_PUBLIC_SC_PORT=8000

# Web URL (used by API for CORS)
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Media Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=

# Media Processing
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Social Providers — Twitter/X
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_URL=http://localhost:3001/callback/twitter

# Social Providers — Meta (Facebook/Instagram)
META_APP_ID=
META_APP_SECRET=
META_CALLBACK_URL=http://localhost:3001/callback/meta

# External Services
UNSPLASH_ACCESS_KEY=
TENOR_API_KEY=
