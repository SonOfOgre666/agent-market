@startuml agent-market-classes
!theme plain
title Agent-Market — Diagramme de classes (domaine MongoDB)

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

' ─── Énumérations ───────────────────────────────────────────
enum PostStatus {
  DRAFT = 0
  SCHEDULED = 1
  PUBLISHED = 2
  FAILED = 3
}

enum CampaignStatus {
  draft
  active
  paused
  ended
}

enum WorkflowStatus {
  pending
  planning
  planned
  awaiting_approval
  approved
  queued
  running
  completed
  failed
  cancelled
}

enum AccountProvider <<social>> {
  twitter
  facebook
  instagram
  instagram_login
  tiktok
  linkedin
}

enum AdsProvider <<ads>> {
  google_ads
  meta_ads
}

' ─── Identité & espace de travail ───────────────────────────
class User {
  +ObjectId _id
  +String name
  +String email
  +String passwordHash
  +Date created_at
  +Date updated_at
  --
  +findByEmail()
  +createUser()
  +verifyPassword()
}

class Workspace {
  +ObjectId _id
  +String name
  +ObjectId owner_id
  +Member[] members
  +Date deleted_at
  --
  +findByUserId()
  +addMember()
  +createInvite()
}

class "Member (embedded)" as Member {
  +ObjectId user_id
  +String role
  +Date joined_at
}

User "1" -- "0..*" Workspace : owner / membre >
Workspace *-- "1..*" Member

' ─── Comptes connectés ──────────────────────────────────────
class Account {
  +ObjectId _id
  +String uuid
  +ObjectId workspace_id
  +String provider
  +String provider_id
  +String name
  +String username
  +Object access_token
  +Boolean authorized
  +Boolean pending_entities
  +Object media
  +Object data
  --
  +upsertAccount()
  +findByProvider()
}

Workspace "1" o-- "0..*" Account
Account ..> AccountProvider : social
Account ..> AdsProvider : ads

' ─── Social : posts & médias ────────────────────────────────
class Post {
  +ObjectId _id
  +String uuid
  +ObjectId workspace_id
  +ObjectId[] account_ids
  +ObjectId[] tag_ids
  +Version[] versions
  +Date scheduled_at
  +PostStatus status
  +Int schedule_status
  +Date deleted_at
  --
  +findScheduledReady()
  +createPost()
}

class "Version (embedded)" as Version {
  +String locale
  +Object content
  +ObjectId[] media_ids
}

class Tag {
  +ObjectId _id
  +String uuid
  +ObjectId workspace_id
  +String name
  +String hex_color
}

class Media {
  +ObjectId _id
  +String uuid
  +ObjectId workspace_id
  +String name
  +String mime_type
  +String path
  +Long size
}

class ImportedPost {
  +ObjectId account_id
  +String provider_post_id
  +Object content
  +Object metrics
}

class Metric {
  +ObjectId account_id
  +String date
  +Object data
  --
  +upsert()
}

class Audience {
  +ObjectId account_id
  +String date
  +Int total
}

Workspace "1" o-- "0..*" Post
Workspace "1" o-- "0..*" Tag
Workspace "1" o-- "0..*" Media
Post *-- "1..*" Version
Post "0..*" --> "0..*" Account : publie sur
Post "0..*" --> "0..*" Tag
Version "0..*" --> "0..*" Media
Account "1" o-- "0..*" ImportedPost
Account "1" o-- "0..*" Metric
Account "1" o-- "0..*" Audience
Post ..> PostStatus

' ─── Ads ────────────────────────────────────────────────────
class Campaign {
  +ObjectId _id
  +String uuid
  +ObjectId workspace_id
  +String platform
  +String type
  +CampaignStatus status
  +Object budget
  +Object targeting
  +Object creatives
  +ObjectId account_id
  +Date scheduled_at
  --
  +findScheduledReady()
  +createCampaign()
}

class LandingPage {
  +ObjectId _id
  +String uuid
  +ObjectId workspace_id
  +ObjectId campaign_id
  +String slug
  +String status
  +Object form_fields
}

class Lead {
  +ObjectId _id
  +String uuid
  +ObjectId workspace_id
  +ObjectId landing_page_id
  +ObjectId campaign_id
  +Object data
  +Object utm
}

Workspace "1" o-- "0..*" Campaign
Workspace "1" o-- "0..*" LandingPage
Workspace "1" o-- "0..*" Lead
Campaign "1" o-- "0..*" LandingPage
Campaign "0..1" <-- Lead
LandingPage "0..1" <-- Lead
Campaign ..> CampaignStatus
Campaign "0..1" --> Account : compte ads

' ─── Agent IA ───────────────────────────────────────────────
class AgentConversation {
  +ObjectId _id
  +ObjectId workspace_id
  +ObjectId user_id
  +String title
  +Message[] messages
  --
  +appendMessage()
}

class "Message (embedded)" as AgentMessage {
  +String id
  +String role
  +String content
  +String workflow_id
}

class AgentWorkflow {
  +ObjectId _id
  +String workflow_id
  +ObjectId workspace_id
  +ObjectId user_id
  +ObjectId conversation_id
  +String user_message
  +WorkflowStatus status
  +Object graph
  +Object step_results
  --
  +create()
  +patch()
}

Workspace "1" o-- "0..*" AgentConversation
Workspace "1" o-- "0..*" AgentWorkflow
User "1" --> "0..*" AgentConversation
User "1" --> "0..*" AgentWorkflow
AgentConversation *-- "0..*" AgentMessage
AgentConversation "1" o-- "0..*" AgentWorkflow
AgentWorkflow ..> WorkflowStatus

' ─── Configuration ──────────────────────────────────────────
class Setting {
  +ObjectId workspace_id
  +String key
  +Object value
}

class Service {
  +String slug
  +Object configuration
  +Boolean active
}

Workspace "1" o-- "0..*" Setting
Workspace "1" o-- "0..*" Service

note bottom of Post
  **post_accounts** (collection liée) :
  état de publication par compte
  (provider_post_id, errors)
end note

note bottom of Account
  Providers sociaux vs ads
  (accountKinds.js)
end note

@enduml
