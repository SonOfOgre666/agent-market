@startuml agent-market-sequence-publish-post
!theme plain
title Séquence — Planification et publication d'un post social

actor Utilisateur
participant "Next.js" as Web
participant "API Fastify" as API
participant "Redis\n(bridge Celery)" as Redis
participant "Celery Worker\n(ai-worker)" as Worker
participant "Connecteurs\n(twitter, meta…)" as Connector
database "MongoDB" as DB
participant "SocketCluster\n(realtime)" as RT

== Création / planification (UI) ==

Utilisateur -> Web : Créer post + date
Web -> API : POST /api/posts (ou schedule)
API -> DB : Post.createPost() / update
DB --> API : post
alt Planification via worker
  API -> Redis : LPUSH agentmarket:api_task_bridge\n{task: tasks.social.schedule_post}
  Redis --> Worker : bridge RPOP → send_task
  Worker -> API : PATCH /api/internal/worker/...\n(X-Worker-Secret)
  API -> DB : mise à jour scheduled_at, status
end
API --> Web : post JSON
Web --> Utilisateur : Confirmation calendrier

== Publication due (Beat) ou immédiate ==

note over Worker
  scheduler_beat : posts où
  scheduled_at <= now
  et schedule_status = PENDING
end note

Worker -> API : GET /api/internal/worker/\npost-publish-bundle/:postId
API -> DB : Post + Accounts + Media
DB --> API : bundle
API --> Worker : JSON bundle

loop Pour chaque compte cible
  Worker -> Connector : publish_post(account, version)
  Connector -> Connector : API plateforme (OAuth token)
  Connector --> Worker : provider_post_id / erreur
  Worker -> API : PUT post-accounts\n(provider_post_id, errors)
  API -> DB : upsert post_accounts
end

Worker -> API : PATCH posts/:id\n(status=PUBLISHED|FAILED)
API -> DB : update Post
API -> Redis : publish event (lib/events.js)
Redis -> RT : pub/sub
RT --> Web : WebSocket events
Web --> Utilisateur : Notification temps réel

@enduml
