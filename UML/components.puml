@startuml agent-market-components
!theme plain
title Agent-Market — Diagramme de composants (runtime)

package "Client" {
  [Navigateur] as Browser
}

package "Frontend" {
  [Next.js App Router\napps/web] as Web
}

package "Backend API" {
  [Fastify Server\napps/api] as API
  [Routes /api/*] as Routes
  [worker_internal\n/api/internal/worker] as Internal
  [Models + Services] as Domain
}

package "Workers" {
  [Celery Worker + Beat\nservices/ai-worker] as Celery
  [Connecteurs marketing\nconnectors/] as Connectors
  [LLM lib/llm] as LLM
}

package "Infrastructure" {
  database "MongoDB" as Mongo
  queue "Redis" as Redis
  [SocketCluster\nservices/realtime] as SC
}

cloud "Plateformes externes" {
  [Meta / Facebook / IG] as Meta
  [Google Ads] as Google
  [X / LinkedIn / TikTok] as Social
  [Gemini / OpenAI] as AI
}

Browser --> Web : HTTPS
Web --> Routes : REST + JWT cookie
Routes --> Domain
Domain --> Mongo
Routes --> Redis : enqueue Celery bridge
Celery --> Redis : broker + bridge RPOP
Celery --> Connectors
Celery --> LLM
Connectors --> Meta
Connectors --> Google
Connectors --> Social
LLM --> AI
Celery --> Internal : httpx worker_api\nX-Worker-Secret
Internal --> Domain
Routes --> Redis : publish events
Redis --> SC : pub/sub
SC --> Browser : WebSocket

note bottom of Internal
  Source de vérité Mongo pour
  publish bundles, post_accounts,
  sync ads apply, métriques
end note

@enduml
