@startuml agent-market-use-cases
!theme plain
title Agent-Market — Diagramme de cas d'utilisation

left to right direction
skinparam actorStyle awesome

actor "Utilisateur\n(marketeur)" as User
actor "Visiteur web" as Visitor
actor "Worker Celery\n(planificateur)" as Worker
actor "Plateformes\n(Meta, Google, X…)" as Platform

rectangle "Agent-Market" {

  package "Authentification & workspace" {
    usecase "S'inscrire" as UC_Register
    usecase "Se connecter (JWT)" as UC_Login
    usecase "Gérer le profil" as UC_Profile
    usecase "Créer / rejoindre un workspace" as UC_Workspace
    usecase "Inviter des membres" as UC_Invite
  }

  package "Comptes & intégrations" {
    usecase "Connecter un compte social (OAuth)" as UC_OAuthSocial
    usecase "Connecter un compte publicitaire" as UC_OAuthAds
    usecase "Importer profil / entités" as UC_ImportAccount
    usecase "Configurer services (clés API)" as UC_Services
  }

  package "Social — contenu" {
    usecase "Créer un brouillon de post" as UC_DraftPost
    usecase "Générer un post avec l'IA" as UC_AIPost
    usecase "Planifier une publication" as UC_SchedulePost
    usecase "Publier immédiatement" as UC_PublishNow
    usecase "Gérer médias et tags" as UC_MediaTags
    usecase "Consulter le calendrier éditorial" as UC_Calendar
    usecase "Importer posts / followers" as UC_ImportSocial
    usecase "Consulter métriques sociales" as UC_SocialMetrics
  }

  package "Publicité (Ads)" {
    usecase "Créer / modifier une campagne" as UC_Campaign
    usecase "Publier une campagne (Meta / Google)" as UC_PublishCampaign
    usecase "Synchroniser campagnes distantes" as UC_AdsSync
    usecase "Créer une landing page" as UC_Landing
    usecase "Consulter les leads" as UC_Leads
    usecase "Rapports performance ads" as UC_AdsReports
  }

  package "Assistant agent" {
    usecase "Discuter avec l'assistant marketing" as UC_AgentChat
    usecase "Planifier un workflow multi-étapes" as UC_AgentPlan
    usecase "Approuver et exécuter un workflow" as UC_AgentExecute
    usecase "Suivre l'état d'un job agent" as UC_AgentPoll
  }

  package "Transversal" {
    usecase "Tableau de bord" as UC_Dashboard
    usecase "Rapports & exports" as UC_Reports
    usecase "Notifications temps réel" as UC_Realtime
    usecase "Paramètres workspace" as UC_Settings
  }

  package "Public (sans auth)" {
    usecase "Soumettre un formulaire lead" as UC_LeadSubmit
    usecase "Voir une landing page publiée" as UC_LandingView
  }

  package "Worker (système)" {
    usecase "Traiter posts dus (Beat)" as UC_BeatPosts
    usecase "Traiter campagnes dues" as UC_BeatCampaigns
    usecase "Sync ads planifiée" as UC_BeatAdsSync
    usecase "Traiter imports & métriques" as UC_BeatImports
  }
}

' ─── Acteurs principaux ─────────────────────────────────────
User --> UC_Register
User --> UC_Login
User --> UC_Profile
User --> UC_Workspace
User --> UC_Invite
User --> UC_OAuthSocial
User --> UC_OAuthAds
User --> UC_ImportAccount
User --> UC_Services
User --> UC_DraftPost
User --> UC_AIPost
User --> UC_SchedulePost
User --> UC_PublishNow
User --> UC_MediaTags
User --> UC_Calendar
User --> UC_ImportSocial
User --> UC_SocialMetrics
User --> UC_Campaign
User --> UC_PublishCampaign
User --> UC_AdsSync
User --> UC_Landing
User --> UC_Leads
User --> UC_AdsReports
User --> UC_AgentChat
User --> UC_AgentPlan
User --> UC_AgentExecute
User --> UC_AgentPoll
User --> UC_Dashboard
User --> UC_Reports
User --> UC_Realtime
User --> UC_Settings

Visitor --> UC_LeadSubmit
Visitor --> UC_LandingView

Worker --> UC_BeatPosts
Worker --> UC_BeatCampaigns
Worker --> UC_BeatAdsSync
Worker --> UC_BeatImports

Platform <-- UC_OAuthSocial
Platform <-- UC_OAuthAds
Platform <-- UC_PublishNow
Platform <-- UC_PublishCampaign
Platform <-- UC_AdsSync
Platform <-- UC_ImportSocial
Platform <-- UC_ImportAccount

' ─── Inclusions / extensions ────────────────────────────────
UC_SchedulePost ..> UC_DraftPost : <<include>>
UC_PublishNow ..> UC_DraftPost : <<include>>
UC_AIPost ..> UC_DraftPost : <<extend>>
UC_AgentPlan ..> UC_AgentChat : <<include>>
UC_AgentExecute ..> UC_AgentPlan : <<include>>
UC_AgentPoll ..> UC_AgentChat : <<include>>
UC_LeadSubmit ..> UC_LandingView : <<include>>
UC_BeatPosts ..> UC_PublishNow : déclenche
UC_BeatCampaigns ..> UC_PublishCampaign : déclenche
UC_Landing ..> UC_Campaign : <<extend>>

note right of UC_AdsSync
  Sync bulk : worker + connecteurs
  puis persistance via API interne
  (/api/internal/worker/ads/*)
end note

note bottom of Worker
  Celery Beat + bridge Redis
  (agentmarket:api_task_bridge)
end note

@enduml
