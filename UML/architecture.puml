@startuml agent-market-architecture-context
!theme plain
title Agent-Market — Niveau 1 : Contexte système (C4)

skinparam rectangle {
  roundCorner 10
}

actor "Marketeur" as User
actor "Visiteur" as Visitor

rectangle "Agent-Market Platform" {
  [Application web\nNext.js] as Web
  [API métier\nFastify] as API
  [Worker async\nCelery + Beat] as Worker
  [Temps réel\nSocketCluster] as RT
}

database "MongoDB" as DB
queue "Redis" as Redis

cloud "Réseaux sociaux" as Social {
  [X, LinkedIn, TikTok]
  [Meta / Instagram / Facebook]
}
cloud "Publicité" as Ads {
  [Google Ads API]
  [Meta Marketing API]
}
cloud "IA" as AI {
  [Gemini / OpenAI / Anthropic]
}

User --> Web : HTTPS
Visitor --> Web : Landing pages / leads
Web --> API : REST /api/* + JWT
API --> DB : persistance (source de vérité)
API --> Redis : enqueue + events
Worker --> Redis : broker + bridge
Worker --> API : /api/internal/worker/*\n(M2M secret)
Worker --> Social
Worker --> Ads
Worker --> AI
API --> Redis : pub événements
Redis --> RT : pub/sub
RT --> Web : WebSocket
Web --> User : notifications UI

note right of API
  **Pas un MVC serveur classique**
  L'API orchestre et persiste ;
  elle ne publie pas directement
  sur les réseaux sociaux.
end note

@enduml

@startuml agent-market-architecture-layers
!theme plain
title Agent-Market — Niveau 2 : Architecture logique en couches

skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 30

' ─── Légende pattern ───────────────────────────────────────
legend right
  |= Pattern réel |= Rôle |
  | **Layered + Modular monolith** | API Node monolithique par modules |
  | **API as Source of Truth** | MongoDB écrit surtout par l'API |
  | **Async command / task queue** | Celery via bridge Redis |
  | **Ports & Adapters** | connectors/ vers plateformes |
  | **Event notification** | Redis → SocketCluster |
  | ~~MVC classique~~ | **Non** : pas de contrôleur unique ni vue serveur |
endlegend

package "Présentation (Client)" #E8F4FD {
  rectangle "apps/web — Next.js App Router" as WebLayer {
    [Pages /app/*] as Pages
    [Components UI] as Components
    [Hooks & modules\nuseAgentChat, api.js] as Hooks
    [AuthProvider /\nRealtimeProvider] as Providers
  }
}

package "API — Bordure HTTP" #FFF8E1 {
  rectangle "apps/api — Fastify" as ApiLayer {
    [Routes\nroutes/*.js] as Routes #LightYellow
    [Middleware\nauth.js] as MW
    [OAuth callbacks\n(callback.js)] as Callback
    [Internal M2M\nworker_internal.js] as Internal
  }
}

package "API — Application" #F1F8E4 {
  rectangle "Orchestration" as AppOrch {
    [Services\npostCreate, postSocialEnqueue] as Services
    [Dispatcher\nqueue/dispatcher.js] as Dispatcher
    [Bridges\nagentCeleryBridge, celeryEnqueue] as Bridges
    [Validation\nagentValidation, adsWorkflowSchemas] as Validation
  }
}

package "API — Domaine & données" #FCE4EC {
  rectangle "Accès données (Active Record léger)" as DataLayer {
    [Models\nmodels/*.js] as Models
    [Constants\naccountKinds.js] as Constants
  }
}

package "API — Infrastructure" #ECEFF1 {
  rectangle "Infra transverse" as InfraApi {
    [lib/mongo.js] as MongoLib
    [lib/redis.js] as RedisLib
    [lib/events.js] as Events
    [providers/\nmeta, google_ads…] as NodeProviders
    [media/processor] as MediaProc
  }
}

package "Worker — Exécution async" #EDE7F6 {
  rectangle "services/ai-worker" as WorkerLayer {
    [tasks/\nsocial, ads, imports] as Tasks
    [connectors/\nPorts externes] as Connectors
    [lib/worker_api.py\n→ API interne] as WorkerApi
    [lib/llm/\nGemini, OpenAI] as LLM
    [registry/tools.json] as Registry
    [agents/planner] as AgentPlanner
  }
}

package "Données & messaging" #E0F2F1 {
  database "MongoDB\ncollections métier" as Mongo
  queue "Redis\nbroker, bridge, pub/sub" as Redis
  [SocketCluster\nservices/realtime] as SC
}

cloud "Systèmes externes" as Ext

' ─── Flux verticaux ─────────────────────────────────────────
Pages --> Components
Components --> Hooks
Hooks --> Routes : fetch REST
Providers --> Routes
MW --> Routes
Routes --> Services
Routes --> Models
Routes --> Dispatcher
Services --> Models
Services --> Bridges
Dispatcher --> Bridges
Bridges --> Redis : LPUSH bridge
Validation --> Routes
Models --> MongoLib
MongoLib --> Mongo
Internal --> Models
Internal --> Events
Events --> Redis
Redis --> SC

Tasks --> Connectors
Tasks --> WorkerApi
Tasks --> LLM
WorkerApi --> Internal
Connectors --> Ext
LLM --> Ext
Redis --> Tasks : Beat + bridge RPOP
NodeProviders --> Ext : OAuth token refresh\n(côté API)

note bottom of Routes
  **Couche « contrôleur » légère**
  Valide JWT/workspace, délègue
  aux models/services/enqueue.
  Pas de logique plateforme lourde.
end note

note bottom of Connectors
  **Adaptateurs (hexagonal)**
  Stateless HTTP/SDK ;
  pas de persistance métier.
end note

note bottom of Models
  Fonctions exportées par collection
  (findAll, create, patch…) —
  proche **Repository / Active Record**,
  pas entités riches DDD complètes.
end note

@enduml

@startuml agent-market-architecture-flows
!theme plain
title Agent-Market — Niveau 3 : Flux synchrones vs asynchrones

|Utilisateur|
start
:Action UI\n(ex. publier post);

|Next.js|
:api.js → POST /api/posts;

|API Route|
:authenticate +\nvalidation;

if (Lecture seule ?) then (oui)
  |Model|
  :findAll / findById;
  |MongoDB|
  :query;
  |API|
  :JSON response;
  stop
else (écriture / action lourde)
  |Service / Dispatcher|
  :enqueueCeleryTask\nou enqueue + wait;
  |Redis bridge|
  :LPUSH task JSON;
  |API|
  :202 / poll job_id\nou attendre réponse sync;
endif

|Celery bridge|
:RPOP → send_task;

|Celery Task|
:Récupère bundle\n(worker_api GET);

|API Internal|
:worker_internal +\nModels;

|MongoDB|
:lecture bundle;

|Celery Task|
:connectors/*.py\nappel plateforme;

|Plateforme|
:API OAuth;

|Celery Task|
:PATCH/PUT internal\n(post_accounts, status);

|API Internal|
:persiste état final;

|Events|
:publish → Redis;

|SocketCluster|
:push WebSocket;

|Next.js|
:mise à jour UI;

stop

@enduml

@startuml agent-market-architecture-mvc-comparison
!theme plain
title Agent-Market — Pourquoi ce n'est pas du MVC classique

together {
  rectangle "**MVC classique (web)**" #FFEBEE {
    card "View" as MVC_V #FFB4AB
    card "Controller" as MVC_C #FF8A80
    card "Model" as MVC_M #E57373
    MVC_V --> MVC_C : actions utilisateur
    MVC_C --> MVC_M : CRUD
    MVC_M --> MVC_V : données pour rendu
    MVC_C --> MVC_V : choisit la vue
  }
}

together {
  rectangle "**Agent-Market (réel)**" #E8F5E9 {
    card "View\n(Next.js client)" as AM_V #A5D6A7
    card "API Routes\n(contrôleurs fins)" as AM_R #81C784
    card "Services +\nDispatcher" as AM_S #66BB6A
    card "Models\n(accès Mongo)" as AM_M #4CAF50
    card "Celery Tasks\n(exécution)" as AM_T #388E3C
    card "Connectors\n(adaptateurs)" as AM_X #2E7D32

    AM_V --> AM_R : REST JSON
    AM_R --> AM_S : orchestration
    AM_R --> AM_M : lectures simples
    AM_S --> AM_M : persistance
    AM_S --> AM_T : enqueue (Redis)
    AM_T --> AM_X : logique externe
    AM_T --> AM_R : **worker_internal**\n(pas le Model worker)
    AM_R --> AM_M : vérité Mongo
    AM_V ..> AM_V : rendu React\n(pas de vue serveur)
  }
}

note as N1
  **Équivalences approximatives**
  • View ≈ apps/web (React)
  • Controller ≈ routes/ (mince)
  • Model ≈ models/ + MongoDB
  **+ extensions non-MVC**
  • Worker = couche d'exécution séparée
  • Connectors = ports hexagonaux
  • Events = notification async
end note

@enduml

