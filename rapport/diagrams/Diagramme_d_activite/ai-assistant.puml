@startuml ai-assistant-activity
!theme plain
title Assistant IA — Diagramme d'activité\n(chat → planification → approbation → exécution)

skinparam ActivityBackgroundColor #FEFEFE
skinparam ActivityBorderColor #333333
skinparam ArrowColor #333333

|Utilisateur|
start
:Ouvrir la page Assistant IA\n(/agent);

if (Reprendre une conversation ?) then (oui)
  |Frontend Next.js|
  :GET /api/agent/conversations/:id;
  |API Node.js|
  :Charger AgentConversation\n+ workflows liés;
  |Frontend Next.js|
  :Afficher historique chat;
else (non)
  :Nouvelle conversation;
endif

|Utilisateur|
:Saisir un message marketing\n(+ pièces jointes média optionnelles, max 4);

|Frontend Next.js|
:POST /api/agent/chat\n{ message, conversation_id?, attachments? };
note right
  Module /modules/agent
  useAgentChat · pollAgentJob
  Événements temps réel (SocketCluster)
end note

|API Node.js|
:validateChatRequest();

if (Requête valide ?) then (non)
  :Réponse 400 / 403 / 422;
  |Utilisateur|
  :Corriger le message;
  stop
else (oui)
endif

:Créer ou charger AgentConversation;
:AgentWorkflow.create\nstatus = **planning**;
:publishEvent(workflow.started);
:enqueuePlanWorkflow\n→ Celery **tasks.agent.plan_workflow**;
:Réponse **202** { job_id, workflow_id, conversation_id };

|Frontend Next.js|
repeat
  :GET /api/agent/jobs/:jobId;
  |API Node.js|
  :Lire résultat Redis (reply_key);
repeat while (status = pending ?) is (oui)
->non;

if (Job planification OK ?) then (non)
  |Frontend Next.js|
  :Afficher erreur assistant;
  |Utilisateur|
  stop
else (oui)
endif

|Planner Celery|
if (Workflow annulé ?) then (oui)
  :status = **cancelled**;
  |Utilisateur|
  stop
else (non)
endif

:Construire le contexte workspace\n(comptes, intégrations, médias);
|Fournisseur IA\n(Gemini)|
:Générer graphe d'étapes\n(intent, steps, summary, assistant_message);
|Planner Celery|
if (Graphe LLM invalide\nou incomplet ?) then (oui)
  :Fallback déterministe\n(social / ads selon intent);
else (non)
  :validate_workflow_graph();
endif

:PATCH AgentWorkflow\nintent · graph · approval_gates;
if (requires_approval ?) then (oui)
  :status = **awaiting_approval**;
else (non)
  :status = **planned**;
endif
:emit **workflow.planned**;

|Frontend Next.js|
:POST /api/agent/chat/complete\n{ conversation_id, workflow_id, assistant_message };
|API Node.js|
:validatePlannedGraph();
:appendMessage(role = assistant);
:Afficher message + WorkflowTimeline;

|Utilisateur|
if (Décision utilisateur) then (Rejeter)
  |Frontend Next.js|
  :POST /api/agent/workflows/:id/reject;
  |API Node.js|
  :status = **cancelled**;
  :emit workflow.cancelled;
  stop
elseif (Arrêter / Stop) then
  |Frontend Next.js|
  :POST /api/agent/workflows/:id/cancel;
  |API Node.js|
  :cancelWorkflowForWorkspace();
  :status = **cancelled**;
  stop
elseif (Approuver) then
  |Frontend Next.js|
  :POST /api/agent/workflows/:id/approve;
  |API Node.js|
  :validateWorkflowExecution(approve);
  :status = **approved** → **queued**;
  :enqueueExecuteWorkflow\n→ **tasks.agent.execute_workflow**;
elseif (Exécuter sans gate) then
  |Frontend Next.js|
  :POST /api/agent/workflows/:id/execute;
  |API Node.js|
  :validateWorkflowExecution(execute);
  :enqueueExecuteWorkflow;
else (Attendre)
  stop
endif

|Frontend Next.js|
repeat
  :GET /api/agent/jobs/:jobId\n+ refreshWorkflow;
  |API Node.js|
  :Lire état job exécution;
repeat while (status = pending ?) is (oui)
->non;

|Executor Celery|
:execute_workflow_steps(approved = true);
note right
  Ordre par depends_on
  Résolution refs step_N.output.*
  dispatch_tool (registry tools.json)
end note

partition "Boucle d'exécution des étapes" {
  while (Étapes restantes ?) is (oui)
    if (Workflow annulé ?) then (oui)
      :status = **cancelled**;
      break
    else (non)
    endif

    :Résoudre dépendances de l'étape;

    if (Étape dans approval_gates\net non approuvée ?) then (oui)
      :step.skipped\n(reason: awaiting_approval);
    else (non)
      :emit step.running;
      if (Outil IA\n(generate_*, script) ?) then (oui)
        |Fournisseur IA\n(Gemini)|
        :Appel LLM / génération;
        |Executor Celery|
      elseif (Outil social / ads\nmutant ?) then (oui)
        :Celery tasks.social / tasks.ads\nou connector API;
        |API Node.js|
        :Persistance Mongo\n(posts, campagnes, leads…);
        |Executor Celery|
      else (interne)
        :Traitement interne;
      endif

      if (Étape réussie ?) then (oui)
        :emit step.completed\nstep_results[sid];
      else (non)
        if (optional_on_failure ?) then (oui)
          :emit step.skipped;
        else (non)
          :emit step.failed;
          break
        endif
      endif
    endif
  endwhile (non)
}

if (Toutes étapes OK ?) then (oui)
  :status = **completed**;
  :emit workflow.completed;
else (non)
  :status = **failed**;
  :emit workflow.failed;
endif

|Frontend Next.js|
:StepResultViewer · timeline mise à jour\n(toasts succès / erreur partielle);

|Utilisateur|
:Consulter résultats\n(posts publiés, campagnes, brouillons…);
stop

@enduml
