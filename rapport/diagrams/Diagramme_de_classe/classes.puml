@startuml agent-market-classes
!theme plain
title Agent-Market — Diagramme de classes (domaine)

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

class Utilisateur {
  nom
  email
  motDePasse
}

class Workspace {
  nom
}

class Membre {
  role
}

class Compte {
  fournisseur
  nom
  autorise
}

class CompteSocial
class CompteAds

CompteSocial --|> Compte
CompteAds --|> Compte

class Post {
  statut
  dateProgrammation
  datePublication
}

class Media {
  nom
  type
}

class Campagne {
  plateforme
  statut
  budget
  dateProgrammation
}

class LandingPage {
  slug
  statut
}

class Lead {
  donnees
  utm
}

class ConversationAgent {
  titre
}

class MessageAgent {
  role
  contenu
  date
}

class WorkflowAgent {
  statut
  messageUtilisateur
  plan
}

' --- Associations ---
Utilisateur "1" -- "0..*" Membre
Workspace "1" *-- "1..*" Membre

Workspace "1" o-- "0..*" Compte
Workspace "1" o-- "0..*" Post
Workspace "1" o-- "0..*" Media
Workspace "1" o-- "0..*" Campagne
Workspace "1" o-- "0..*" LandingPage
Workspace "1" o-- "0..*" Lead
Workspace "1" o-- "0..*" ConversationAgent
Workspace "1" o-- "0..*" WorkflowAgent

Post "0..*" --> "0..*" CompteSocial : publie sur
Post "0..*" --> "0..*" Media : utilise
Campagne "0..*" --> "0..1" CompteAds : publie via
LandingPage "1" <-- "0..*" Lead
Campagne "0..*" -- "0..*" LandingPage

Utilisateur "1" -- "0..*" ConversationAgent
ConversationAgent "1" *-- "0..*" MessageAgent
ConversationAgent "1" o-- "0..*" WorkflowAgent
Utilisateur "1" -- "0..*" WorkflowAgent

note right of Membre
  Rôles : owner, admin, member
end note

note bottom of Post
  Un brouillon peut n'avoir
  aucun compte ; comptes
  requis pour programmer
  ou publier.
end note

@enduml
