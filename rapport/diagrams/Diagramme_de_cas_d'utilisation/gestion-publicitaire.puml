@startuml ads-management
!theme plain
title Gestion Publicitaire — Diagramme de cas d'utilisation

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Utilisateur" as User
actor "Visiteur web" as Visitor
actor "Plateformes publicitaires\n(Google Ads, Meta Ads)" as Ads

rectangle "Agent-Market" {

  package "Gestion Publicitaire" {

    usecase "Créer campagne (brouillon)" as UC_CampaignDraft
    usecase "Sélectionner compte\nads connecté" as UC_SelectAds
    usecase "Publier campagne" as UC_CampaignPub
    usecase "Programmer campagne" as UC_CampaignSchedule
    usecase "Synchroniser campagnes" as UC_AdsSync
    usecase "Gérer landing pages" as UC_Landing
    usecase "Consulter leads" as UC_Leads
    usecase "Soumettre lead\n(formulaire public)" as UC_LeadSubmit
    usecase "Connecter comptes Ads\n(OAuth)" as UC_OAuthAds
    usecase "Consulter performance\nads" as UC_Performance
  }
}

User -- UC_CampaignDraft
User -- UC_CampaignPub
User -- UC_CampaignSchedule
User -- UC_AdsSync
User -- UC_Landing
User -- UC_Leads
User -- UC_OAuthAds
User -- UC_SelectAds
User -- UC_Performance

Visitor -- UC_LeadSubmit

Ads -- UC_OAuthAds
Ads -- UC_CampaignPub
Ads -- UC_AdsSync
Ads -- UC_Performance

UC_CampaignPub      ..> UC_CampaignDraft : <<include>>
UC_CampaignSchedule ..> UC_CampaignDraft : <<include>>
UC_CampaignPub      ..> UC_SelectAds : <<include>>
UC_CampaignSchedule ..> UC_SelectAds : <<include>>
UC_LeadSubmit       ..> UC_Landing : <<include>>

@enduml