@startuml public-jobs
!theme plain
title Accès public & tâches planifiées — Diagramme de cas d'utilisation

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Visiteur web" as Visitor
actor "Worker Celery\n(Beat)" as Worker
actor "Plateformes sociales\n(Meta, X, TikTok…)" as Social
actor "Plateformes publicitaires\n(Google Ads, Meta Ads)" as Ads


  package "Accès public (sans auth)" {
    usecase "Voir landing page\npubliée" as UC_ViewLanding
    usecase "Soumettre lead\n(formulaire public)" as UC_LeadSubmit
  }

  package "Tâches planifiées (Beat)" {
    usecase "Traiter posts dus\n(Beat)" as UC_BeatPosts
    usecase "Traiter campagnes dues\n(Beat)" as UC_BeatCampaigns
    usecase "Sync ads planifiée\n(Beat)" as UC_BeatAdsSync
    usecase "Traiter imports\n& métriques (Beat)" as UC_BeatImports
  }


' ─── Accès public ───────────────────────────────────────────
Visitor -- UC_ViewLanding
Visitor -- UC_LeadSubmit

UC_LeadSubmit ..> UC_ViewLanding : <<include>>

' ─── Worker Celery (acteur système) ─────────────────────────
Worker -- UC_BeatPosts
Worker -- UC_BeatCampaigns
Worker -- UC_BeatAdsSync
Worker -- UC_BeatImports

' ─── Plateformes externes (acteurs secondaires) ─────────────
Social -- UC_BeatPosts
Social -- UC_BeatImports
Ads -- UC_BeatCampaigns
Ads -- UC_BeatAdsSync

@enduml
