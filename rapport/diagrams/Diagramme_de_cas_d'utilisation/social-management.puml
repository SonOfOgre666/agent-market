@startuml social-management
!theme plain
title Gestion Sociale — Diagramme de cas d'utilisation

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Utilisateur" as User
actor "Plateformes sociales\n(Meta, X, TikTok…)" as Social
actor "Fournisseur IA\n(Gemini…)" as LLM


package "Gestion Sociale" {

  usecase "Créer post (brouillon)" as UC_Draft
  usecase "Générer contenu IA" as UC_AIGen
  usecase "Sélectionner comptes\nconnectés" as UC_SelectAccounts
  usecase "Programmer post" as UC_Schedule
  usecase "Publier post" as UC_Publish
  usecase "Connecter comptes sociaux\n(OAuth)" as UC_OAuthSocial
  usecase "Consulter calendrier\néditorial" as UC_Calendar
  usecase "Consulter métriques\nsociales" as UC_Metrics
}


' ─── Acteur principal ───────────────────────────────────────
User -- UC_Draft
User -- UC_AIGen
User -- UC_Schedule
User -- UC_Publish
User -- UC_OAuthSocial
User -- UC_Calendar
User -- UC_Metrics

' ─── Acteurs secondaires (systèmes externes) ────────────────
Social -- UC_OAuthSocial
Social -- UC_Publish
Social -- UC_Metrics
LLM -- UC_AIGen

' ─── Relations entre cas d'utilisation ──────────────────────
UC_Schedule ..> UC_Draft : <<include>>
UC_Publish  ..> UC_Draft : <<include>>
UC_Schedule ..> UC_SelectAccounts : <<include>>
UC_Publish  ..> UC_SelectAccounts : <<include>>
UC_AIGen    ..> UC_Draft : <<extend>>


@enduml
