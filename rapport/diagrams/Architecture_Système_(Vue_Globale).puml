@startuml agent-market-architecture
!theme plain
title Agent-Market — Architecture Système (Vue Globale)\nLecture : 1 → 10, de gauche à droite

left to right direction
skinparam shadowing false
skinparam roundCorner 10
skinparam packageStyle rectangle
skinparam nodesep 35
skinparam ranksep 55
skinparam ArrowFontSize 11
skinparam DefaultFontSize 12
skinparam LegendBackgroundColor #FAFAFA

actor "Utilisateur" as User

rectangle "1. Interface\nNext.js / React" as P1 #E8F5E9 {
  [Interface web] as Web
}

rectangle "2. API\nFastify / Node.js" as P2 #E3F2FD {
  [API métier] as API
}

rectangle "3. Données\nMongoDB + Redis" as P3 #FFF8E1 {
  database "MongoDB" as DB
  queue "Redis\nfile Celery\n+ Pub/Sub" as Queue
}

rectangle "4. Traitement" as P4 #F3E5F5 {
  [Worker\nPython / Celery] as Worker
  [Temps réel\nSocketCluster] as RT
}

rectangle "5. Externes" as P5 #FFEBEE {
  cloud "IA\nOpenAI / Anthropic / Gemini" as AI
  cloud "Social\nMeta, X, …" as Social
  cloud "Ads\nMeta / Google" as Ads
}

' --- Flux principal (aller) ---
User --> Web : **1** utilise\nl'interface
Web --> API : **2** requêtes\nHTTP (JWT)
API --> DB : **3** lit /\nenregistre
API --> Queue : **4** LPUSH tâches\n(bridge Celery)
Queue --> Worker : **5** consomme\net exécute
Worker --> AI : **6a** génère\ndu contenu
Worker --> Social : **6b** publie /\nsynchronise
Worker --> Ads : **6c** gère les\ncampagnes

' --- Retours ---
Worker --> API : **7** HTTP interne\n(résultats)
API --> Queue : **8** PUBLISH\névénement
Queue --> RT : **9** Pub/Sub\n→ relay SC
RT --> Web : **10** canal events\n(SocketCluster)

' Alignement vertical propre
DB -[hidden]down- Queue
Worker -[hidden]down- RT
AI -[hidden]down- Social
Social -[hidden]down- Ads

legend bottom
  |= Étapes |= Signification |
  | **1 → 3** | Requête utilisateur jusqu'à MongoDB |
  | **4 → 7** | File Redis → worker Celery → API (HTTP interne) |
  | **6a / 6b / 6c** | Appels externes (parallèles possibles) |
  | **8 → 10** | Redis Pub/Sub → SocketCluster → interface |
endlegend

@enduml
